{
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^matrix\\.yml$/"],
      "matchStrings": [
        "https://releases\\.nixos\\.org/nix/nix-(?<currentValue>\\d+\\.\\d+\\.\\d+)/install\"?\\s*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+packageName=(?<packageName>\\S+)"
      ]
    }
  ]
}
