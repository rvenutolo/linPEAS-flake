{
  "id": 99999999,
  "name": "release-tag-protection",
  "target": "tag",
  "enforcement": "active",
  "bypass_actors": [{ "actor_id": 1, "actor_type": "RepositoryRole" }],
  "conditions": {
    "ref_name": {
      "include": ["refs/tags/[0-9]{8}-[0-9a-f]{7,40}"],
      "exclude": []
    }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "update" },
    { "type": "non_fast_forward" }
  ]
}
