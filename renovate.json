{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "schedule": ["before 06:00 on friday"],
  "timezone": "UTC",
  "automerge": true,
  "platformAutomerge": true,
  "prConcurrentLimit": 3,
  "dependencyDashboard": false,
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "pinDigests": true
    },
    {
      "description": "Self-reference to local composite action pinned by SHA (CIW-1). Renovate's github-actions manager treats `owner/repo/path@sha` uniformly, so pinDigests above covers the bump path. This rule exists to document intent and to ensure the self-reference is not accidentally excluded by a future matcher.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["rvenutolo/linPEAS-flake"],
      "pinDigests": true,
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "install_url:\\s*https://releases\\.nixos\\.org/nix/nix-(?<currentValue>\\d+\\.\\d+\\.\\d+)/install\\s*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+packageName=(?<packageName>\\S+)"
      ]
    }
  ]
}
