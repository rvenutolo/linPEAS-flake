root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[justfile]
indent_style = tab

[*.sh]
# shfmt reads these EditorConfig keys (see shfmt --help / EditorConfig docs):
# binary_next_line, switch_case_indent, space_redirects, shell_variant, etc.
binary_next_line = true
switch_case_indent = true
space_redirects = true
